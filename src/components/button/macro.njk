{#
  nhswButton(params)

  params:
    text        string  - button text (used if html is not set)
    html        string  - button HTML (takes precedence over text)
    href        string  - if set, renders an <a role="button"> instead of a <button>
    type        string  - button type attribute, defaults to "button"
    name        string  - name attribute (button only)
    value       string  - value attribute (button only)
    disabled    bool    - adds disabled + aria-disabled="true" (button only)
    classes     string  - extra classes, e.g. "nhsw-button--primary", "nhsw-button--small"
    attributes  object  - extra HTML attributes

  nhswButtonGroup(params)
    items       array   - list of nhswButton params objects, rendered inside nhsw-button-group
    classes     string  - extra classes on the group wrapper
    attributes  object  - extra HTML attributes
#}
{%- macro nhswButton(params) -%}
{%- set attrs -%}
 class="nhsw-button{% if params.classes %} {{ params.classes }}{% endif %}"{% for name, value in (params.attributes or {}) %} {{ name }}="{{ value }}"{% endfor %}{% if params.disabled %} disabled aria-disabled="true"{% endif %}
{%- endset -%}
{%- if params.href -%}
<a href="{{ params.href }}" role="button" draggable="false"{{ attrs | safe }}>{{ params.html | safe if params.html else params.text }}</a>
{%- else -%}
<button type="{{ params.type or 'button' }}"{{ attrs | safe }}{% if params.name %} name="{{ params.name }}"{% endif %}{% if params.value %} value="{{ params.value }}"{% endif %}>{{ params.html | safe if params.html else params.text }}</button>
{%- endif -%}
{%- endmacro -%}

{%- macro nhswButtonGroup(params) -%}
<div class="nhsw-button-group{% if params.classes %} {{ params.classes }}{% endif %}"{% for name, value in (params.attributes or {}) %} {{ name }}="{{ value }}"{% endfor %}>
{%- for item in (params.items or []) %}
  {{ nhswButton(item) }}
{%- endfor %}
</div>
{%- endmacro -%}
