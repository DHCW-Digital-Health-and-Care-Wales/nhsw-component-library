{#
  nhswBreadcrumb(params)

  params:
    items           array   (required) - [{ text, href }], ordered root-to-parent.
                            Do not include the current page — it belongs in
                            the page's H1, not the breadcrumb trail.
    mobileBackText  string  - override the mobile "Back to X" link text
    classes         string  - extra classes, e.g. "nhsw-breadcrumb--reverse"
    attributes      object  - extra HTML attributes

  Every item is rendered as a real link. When items has 1 or more entries, a
  mobile-only "Back to <parent>" link is rendered above the full breadcrumb
  list, pointing at the last item (the immediate parent of the current page).
#}
{%- macro nhswBreadcrumb(params) -%}
{%- set items = params.items or [] -%}
{%- set isReverse = params.classes and "nhsw-breadcrumb--reverse" in params.classes -%}
<nav class="nhsw-breadcrumb{% if params.classes %} {{ params.classes }}{% endif %}" aria-label="breadcrumb"{% for name, value in (params.attributes or {}) %} {{ name }}="{{ value }}"{% endfor %}>
{%- if items.length >= 1 %}
{%- set parent = items[items.length - 1] %}
  <p class="nhsw-breadcrumb__mobile-back">
    <a class="nhsw-back-link{% if isReverse %} nhsw-back-link--reverse{% endif %}" href="{{ parent.href }}">{{ params.mobileBackText or ("Back to " ~ parent.text) }}</a>
  </p>
{%- endif %}
  <ol class="nhsw-breadcrumb__list">
{%- for item in items %}
    <li class="nhsw-breadcrumb__list-item"><a class="nhsw-breadcrumb__link" href="{{ item.href }}">{{ item.text }}</a></li>
{%- endfor %}
  </ol>
</nav>
{%- endmacro -%}
