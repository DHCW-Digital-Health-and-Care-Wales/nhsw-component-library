{#
  nhswHeader(params)

  params:
    serviceName    string   - required, the title text shown next to the logo
    serviceUrl     string   - href for the brand link, defaults to "/"
    search         boolean  - whether to show the search form, defaults to true
    searchInputId  string   - id for the search input, defaults to "site-search"
    logoSrc        string   - defaults to "/assets/nhsw-logo.svg"
    logoAlt        string   - defaults to "Digital Health and Care Wales"
    classes        string   - extra classes
    attributes     object   - extra HTML attributes
#}
{%- macro nhswHeader(params) -%}
{%- set search = params.search if params.search is defined else true -%}
{%- set searchInputId = params.searchInputId or "site-search" -%}
<header class="nhsw-site-header{% if params.classes %} {{ params.classes }}{% endif %}"{% for name, value in (params.attributes or {}) %} {{ name }}="{{ value }}"{% endfor %}>
  <div class="nhsw-site-header__container">
    <div class="nhsw-site-header__top">
      <a class="nhsw-site-header__brand" href="{{ params.serviceUrl or '/' }}">
        <span class="nhsw-site-header__logo">
          <img src="{{ params.logoSrc or '/assets/nhsw-logo.svg' }}" alt="{{ params.logoAlt or 'Digital Health and Care Wales' }}">
        </span>
        <span class="nhsw-site-header__title">{{ params.serviceName }}</span>
      </a>
{%- if search %}
      <form class="nhsw-site-header__search" role="search" onsubmit="return false;">
        <label class="nhsw-visually-hidden" for="{{ searchInputId }}">Search</label>
        <input id="{{ searchInputId }}" class="nhsw-site-header__search-input" type="search" placeholder="Search">
        <button class="nhsw-site-header__search-button" type="submit" aria-label="Search"></button>
      </form>
{%- endif %}
    </div>
  </div>
</header>
{%- endmacro -%}
