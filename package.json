{
  "name": "nhsw-style-library",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:css": "sass src/index.scss preview/dist/nhsw.css",
    "postbuild:css": "node -e \"const f=require('fs');f.mkdirSync('preview/dist',{recursive:true});f.copyFileSync('dist/nhsw-date-picker.js','preview/dist/nhsw-date-picker.js');\"",
    "watch:css": "sass --watch src/index.scss:preview/dist/nhsw.css",
    "render:njk": "node scripts/render-njk-examples.js",
    "package:njk": "node scripts/package-njk-components.js",
    "sync:gptr": "node -e \"const f=require('fs');const dist='dist';const targets=['../../../source/repos/GPTR/src/Presentation/Web/GPTR','../../../source/repos/GPTR/src/Presentation/Web/GPTR.Maintenance','../../../source/repos/GPTR_Dev_Wcp_Integration/NWIS.GPTR/Presentation/Web/GPTR','../../../source/repos/GPTR_Dev_Wcp_Integration/NWIS.GPTR/Presentation/Web/GPTR.Maintenance'];targets.forEach(t=>{f.mkdirSync(t+'/Content/nhsw',{recursive:true});f.mkdirSync(t+'/Scripts/nhsw',{recursive:true});f.copyFileSync(dist+'/nhsw.css',t+'/Content/nhsw/nhsw.css');f.copyFileSync(dist+'/nhsw.css.map',t+'/Content/nhsw/nhsw.css.map');f.copyFileSync(dist+'/nhsw-date-picker.js',t+'/Scripts/nhsw/nhsw-date-picker.js');console.log('Synced to '+t);});\""
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "js-yaml": "^5.3.0",
    "jsdom": "^29.1.1",
    "nunjucks": "^3.2.4",
    "sass": "^1.93.2",
    "vitest": "^4.1.10"
  }
}
